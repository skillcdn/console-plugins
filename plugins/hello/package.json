{
  "name": "@skillcdn/console-plugin-hello",
  "version": "0.0.0",
  "private": true,
  "description": "Hello, a plugin of the SkillCDN Console: the plugin console-plugin init writes, kept here as the worked example of this repository's conventions and the smoke test of its toolchain.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/skillcdn/console-plugins/tree/main/plugins/hello#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillcdn/console-plugins.git",
    "directory": "plugins/hello"
  },
  "bugs": "https://github.com/skillcdn/console-plugins/issues",
  "keywords": [
    "skillcdn",
    "console",
    "console-plugin"
  ],
  "files": [
    "dist",
    "skills",
    "SKILLCDN.md",
    "console-plugin.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "console-plugin check",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/pack-files.mjs copy",
    "postpack": "node ../../scripts/pack-files.mjs remove"
  },
  "devDependencies": {
    "@skillcdn/console": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
