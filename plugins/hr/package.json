{
  "name": "@skillcdn/console-plugin-hr",
  "version": "0.0.0",
  "private": true,
  "description": "HR, a plugin of the SkillCDN Console: leave requests, approvals as decisions and balances from a policy written for Korea, the US or your own rules; attendance and the people's records to come.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/skillcdn/console-plugins/tree/main/plugins/hr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillcdn/console-plugins.git",
    "directory": "plugins/hr"
  },
  "bugs": "https://github.com/skillcdn/console-plugins/issues",
  "keywords": [
    "skillcdn",
    "console",
    "console-plugin",
    "hr",
    "leave",
    "pto"
  ],
  "files": [
    "dist",
    "skills",
    "SKILLCDN.md",
    "console-plugin.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "console-plugin check",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/pack-files.mjs copy",
    "postpack": "node ../../scripts/pack-files.mjs remove"
  },
  "devDependencies": {
    "@skillcdn/console": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
