{
  "key": "hr",
  "name": {
    "en": "HR",
    "ko": "인사"
  },
  "description": {
    "en": "Leave and announcements for the workspace: requests that go to each person's manager, balances from a policy for Korea, the US or your own rules, and what HR tells everyone. Attendance to come.",
    "ko": "워크스페이스 구성원의 휴가와 공지사항: 각자의 매니저에게 가는 신청, 한국·미국 법규나 자체 규정에 따른 잔여 일수, 인사 담당이 전하는 공지. 근태와 구성원 기록은 다음에 더합니다."
  },
  "agentNote": {
    "en": "A person's leave, who is out, and what HR announced; HR keeps the rules of leave and writes the announcements here.",
    "ko": "구성원의 휴가와 누가 쉬는지, 인사 공지를 다룹니다. 인사 담당은 휴가 규정을 관리하고 공지를 씁니다."
  },
  "pluginApi": 1,
  "console": ">=0.4.7 <0.5.0",
  "server": "dist/server/index.js",
  "web": "dist/web",
  "skills": "skills",
  "capabilities": [
    "people:read",
    "people:read:all",
    "board:read",
    "board:decisions",
    "board:tasks",
    "events:console",
    "files",
    "jobs"
  ],
  "roles": {
    "member": {
      "name": {
        "en": "Member",
        "ko": "구성원"
      },
      "description": {
        "en": "Requests and cancels their own leave, sees their own balance and history, the calendar as HR allows, and the announcements.",
        "ko": "자기 휴가를 신청·취소하고, 자기 잔여와 내역, 인사 담당이 허용한 범위의 캘린더, 공지를 봅니다."
      }
    },
    "manager": {
      "name": {
        "en": "Manager",
        "ko": "매니저"
      },
      "description": {
        "en": "Whoever someone reports to in the console holds it, granted by nobody: sees the approvals and the people below them at any depth, records their leave and answers their requests.",
        "ko": "콘솔에서 누군가의 매니저인 사람이 따로 부여받지 않고 가집니다. 몇 단계 아래든 구성원의 결재와 구성원 화면을 보고, 휴가를 대신 등록하며, 신청에 답합니다."
      },
      "follows": "reports"
    },
    "hr": {
      "name": {
        "en": "HR",
        "ko": "인사 담당"
      },
      "description": {
        "en": "Keeps leave: people, the approval line, kinds of leave, policies, holidays and balances; records leave for anyone and sees everything. Writes and publishes the announcements.",
        "ko": "휴가 전체를 관리합니다: 구성원, 결재선, 휴가 종류, 규정, 공휴일, 잔여. 누구의 휴가든 등록하고 모든 것을 봅니다. 공지사항을 쓰고 게시합니다."
      }
    }
  },
  "defaultRole": "member",
  "board": {
    "needs": "required",
    "defaults": {
      "key": "hr",
      "name": {
        "en": "HR",
        "ko": "인사"
      },
      "description": {
        "en": "Leave approvals and the people's matters. A decision reaches whoever it is for and the managers above them, wherever they are.",
        "ko": "휴가 결재와 인사 업무. 결정은 받을 사람과 그 위 매니저에게 어디서든 갑니다."
      }
    }
  },
  "menu": {
    "group": "people",
    "order": 10
  },
  "pages": [
    {
      "key": "overview",
      "name": {
        "en": "Overview",
        "ko": "개요"
      },
      "level": "workspace",
      "wide": true
    },
    {
