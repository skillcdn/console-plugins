      },
      "level": "workspace",
      "roles": ["manager", "hr"],
      "wide": true
    },
    {
      "key": "setup",
      "name": {
        "en": "Setup",
        "ko": "설정"
      },
      "level": "workspace",
      "roles": ["hr"],
      "wide": true
    }
  ],
  "widgets": [
